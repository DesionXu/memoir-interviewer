.welcome {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(160deg, #faf3e7 0%, #f2e6d3 45%, #e9d9c0 100%);
  box-sizing: border-box;
}
.emblem { font-size: 110rpx; margin-bottom: 30rpx; }
.title { font-size: 62rpx; font-weight: 600; color: #43332a; letter-spacing: 6rpx; }
.tagline { font-size: 34rpx; color: #8a7660; margin: 26rpx 0 60rpx; letter-spacing: 3rpx; }
.btn-start {
  font-size: 42rpx;
  color: #fff;
  background: #7c6a58;
  border-radius: 999rpx;
  padding: 34rpx 120rpx;
  box-shadow: 0 16rpx 40rpx rgba(122, 94, 58, 0.3);
}
.btn-child {
  margin-top: 26rpx;
  font-size: 36rpx;
  color: #4a3a2c;
  background: #f6f1ea;
  border: 3rpx solid #d9cdbb;
  border-radius: 999rpx;
  padding: 26rpx 80rpx;
}
.who-hint { font-size: 26rpx; color: #9a8a78; margin-top: 20rpx; }
.features { margin-top: 70rpx; display: flex; gap: 20rpx; flex-wrap: wrap; justify-content: center; }
.feature {
  font-size: 28rpx;
  color: #6d5a46;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  padding: 16rpx 36rpx;
}
